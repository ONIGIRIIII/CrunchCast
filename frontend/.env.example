# Copy to .env.local for local development. Both values are public (they end
# up in the browser bundle) - never put secrets in a NEXT_PUBLIC_ variable.

# Where the FastAPI backend runs.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: canonical site URL for metadata, the sitemap and robots.txt.
# Defaults to https://crunch-cast.vercel.app when unset.
# NEXT_PUBLIC_SITE_URL=https://crunch-cast.vercel.app
